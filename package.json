{
  "name": "inkendar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @inkendar/app",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:test": "supabase test db --local",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "npm run dev --workspace @inkendar/app",
    "lint": "eslint .",
    "onboard": "tsx scripts/manual-onboarding.ts",
    "start": "npm run start --workspace @inkendar/app",
    "test": "vitest run",
    "test:auth:integration": "vitest run packages/infrastructure/src/supabase-auth.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "supabase": "2.117.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
