SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INKENDAR_APP_ORIGIN=http://127.0.0.1:3000

# Acceso sintético privado de staging. Guarda los valores solo en el archivo
# ignorado .env.staging.access y cópialos manualmente al gestor de contraseñas.
INKENDAR_STAGING_OWNER_EMAIL=
INKENDAR_STAGING_OWNER_PASSWORD=
INKENDAR_STAGING_ARTIST_EMAIL=
INKENDAR_STAGING_ARTIST_PASSWORD=

# OAuth web client de Google. Registra exactamente este callback en local:
# http://127.0.0.1:3000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
# Base64 de 32 bytes aleatorios; clave independiente para AES-256-GCM.
GOOGLE_TOKEN_ENCRYPTION_KEY=
