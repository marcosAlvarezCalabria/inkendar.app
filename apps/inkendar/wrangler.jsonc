{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "inkendar-local",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-23",
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./build/client"
  },
  "images": { "binding": "IMAGES" },
  "vars": { "INKENDAR_APP_ORIGIN": "http://127.0.0.1:5173" },
  "env": {
    "staging": {
      "name": "inkendar-staging",
      "workers_dev": true,
      "preview_urls": true,
      "images": { "binding": "IMAGES" },
      "vars": { "INKENDAR_APP_ORIGIN": "https://inkendar-staging.calalva82.workers.dev" }
    },
    "production": {
      "name": "inkendar",
      "workers_dev": true,
      "preview_urls": false,
      "images": { "binding": "IMAGES" },
      "vars": { "INKENDAR_APP_ORIGIN": "https://inkendar.calalva82.workers.dev" }
    }
  }
}
